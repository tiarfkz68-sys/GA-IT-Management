# GA & IT Operations Management Environment Variables
# Copy this file to .env and adjust values for your environment.

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connection
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgres://gait_user:gait_secret_password@localhost:5432/gait_db

# Security & Authentication
JWT_SECRET=your_production_secret_key_minimum_32_characters_here
